# Copy to .env.local and run `npx convex dev` to populate local values.
# Production Convex: https://zealous-hound-234.convex.cloud
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex Auth (set on the Convex deployment via `npx convex env set`, not only .env.local):
# SITE_URL=https://it-takes-a-village.vercel.app
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_APPLE_ID=          # Apple Services ID
# AUTH_APPLE_SECRET=      # JWT from Apple key (valid max 6 months)
# JWT_PRIVATE_KEY=        # from `npx @convex-dev/auth`
# JWKS=
